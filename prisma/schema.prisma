generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDIO
  CLIENT
}

enum WalletStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  role      Role     @default(CLIENT)
  phone     String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studio         Studio?
  selections     Selection[]
  clients        Client[]        @relation("ClientUser")
  digitalInvites DigitalInvite[]

  @@map("users")
}

model Studio {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  ownerId   String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clients Client[]
  albums  Album[]
  balance Float    @default(0)

  walletTransactions WalletTransaction[]
  magicLinks         MagicLink[]
  digitalInvites     DigitalInvite[]

  @@map("studios")
}

model WalletTransaction {
  id              String       @id @default(cuid())
  studioId        String
  amount          Float
  referenceNumber String
  status          WalletStatus @default(PENDING)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  studioId  String
  userId    String?
  token     String   @unique @default(cuid())
  createdAt DateTime @default(now())

  studio     Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user       User?       @relation("ClientUser", fields: [userId], references: [id])
  albums     Album[]
  selections Selection[]

  @@unique([phone, studioId])
  @@map("clients")
}

model Album {
  id          String    @id @default(cuid())
  title       String
  studioId    String
  clientId    String
  isActive    Boolean   @default(true)
  isMagic     Boolean   @default(false)
  isIndexing  Boolean   @default(false)
  accessToken String    @unique @default(cuid())
  expiresAt   DateTime?
  eventDate   DateTime?
  selectionLocked Boolean @default(false)
  selectionSubmittedAt DateTime?
  coverUrl    String?
  requirePayment Boolean @default(false)
  price          Float?
  isPaid         Boolean @default(false)
  paymentId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  photos Photo[]
  magicRegistrations MagicRegistration[]
  magicLinks         MagicLink[]

  @@map("albums")
}

model Photo {
  id           String   @id @default(cuid())
  albumId      String
  fileName     String
  previewUrl   String
  thumbnailUrl String
  originalUrl  String?
  width        Int      @default(0)
  height       Int      @default(0)
  fileSize     Int      @default(0)
  faceIds      String[] @default([])
  createdAt    DateTime @default(now())

  album      Album       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  selections Selection[]

  @@index([albumId])
  @@index([faceIds])
  @@map("photos")
}

model Selection {
  id         String   @id @default(cuid())
  photoId    String
  clientId   String
  userId     String?
  isSelected Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  photo  Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@unique([photoId, clientId])
  @@map("selections")
}

model MagicRegistration {
  id        String   @id @default(cuid())
  albumId   String
  email     String
  selfieUrl String
  status    String   @default("PENDING") // PENDING, SENT, FAILED, NO_MATCH
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([albumId, email])
  @@map("magic_registrations")
}

model MagicLink {
  id        String   @id @default(cuid())
  name      String
  studioId  String
  albumId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studio    Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  album     Album?   @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@map("magic_links")
}

model DigitalInvite {
  id              String   @id @default(cuid())
  studioId        String?
  userId          String?
  templateId      String   @default("elegant-dark")
  groomName       String
  brideName       String
  heroVideoUrl    String?
  heroImageUrl    String?
  bgMusicUrl      String?
  storyText       String?
  weddingDate     DateTime?
  paymentStatus   String   @default("PENDING")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  studio Studio? @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  events DigitalInviteEvent[]
  guests Guest[]
  rsvps  RSVP[]

  @@map("digital_invites")
}

model DigitalInviteEvent {
  id              String   @id @default(cuid())
  inviteId        String
  name            String   // e.g., "Haldi", "Sangeet", "Wedding"
  date            DateTime
  locationName    String
  locationUrl     String?  // Google Maps URL
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invite DigitalInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@map("digital_invite_events")
}

model Guest {
  id              String   @id @default(cuid())
  inviteId        String
  name            String
  email           String?
  phone           String?
  allowedEvents   String[] // Array of event names they are invited to
  viewedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invite DigitalInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  rsvp   RSVP?

  @@map("guests")
}

model RSVP {
  id              String   @id @default(cuid())
  inviteId        String
  guestId         String   @unique
  isAttending     Boolean
  mealPreference  String?
  message         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invite DigitalInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  guest  Guest         @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@map("rsvps")
}
