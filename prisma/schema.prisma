generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDIO
  CLIENT
}

enum WalletStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CLIENT)
  phone     String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studio     Studio?
  selections Selection[]
  clients    Client[]    @relation("ClientUser")

  @@map("users")
}

model Studio {
  id        String   @id @default(cuid())
  name      String
  ownerId   String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clients Client[]
  albums  Album[]
  balance Float    @default(0)

  walletTransactions WalletTransaction[]

  @@map("studios")
}

model WalletTransaction {
  id              String       @id @default(cuid())
  studioId        String
  amount          Float
  referenceNumber String
  status          WalletStatus @default(PENDING)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  studioId  String
  userId    String?
  token     String   @unique @default(cuid())
  createdAt DateTime @default(now())

  studio     Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user       User?       @relation("ClientUser", fields: [userId], references: [id])
  albums     Album[]
  selections Selection[]

  @@unique([phone, studioId])
  @@map("clients")
}

model Album {
  id          String    @id @default(cuid())
  title       String
  studioId    String
  clientId    String
  isActive    Boolean   @default(true)
  isMagic     Boolean   @default(false)
  accessToken String    @unique @default(cuid())
  expiresAt   DateTime?
  selectionLocked Boolean @default(false)
  selectionSubmittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  photos Photo[]
  magicRegistrations MagicRegistration[]

  @@map("albums")
}

model Photo {
  id           String   @id @default(cuid())
  albumId      String
  fileName     String
  previewUrl   String
  thumbnailUrl String
  originalUrl  String?
  width        Int      @default(0)
  height       Int      @default(0)
  fileSize     Int      @default(0)
  faceIds      String[] @default([])
  createdAt    DateTime @default(now())

  album      Album       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  selections Selection[]

  @@index([albumId])
  @@index([faceIds])
  @@map("photos")
}

model Selection {
  id         String   @id @default(cuid())
  photoId    String
  clientId   String
  userId     String?
  isSelected Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  photo  Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@unique([photoId, clientId])
  @@map("selections")
}

model MagicRegistration {
  id        String   @id @default(cuid())
  albumId   String
  email     String
  selfieUrl String
  status    String   @default("PENDING") // PENDING, SENT, FAILED, NO_MATCH
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([albumId, email])
  @@map("magic_registrations")
}
